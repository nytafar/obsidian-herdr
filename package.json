{
	"name": "obsidian-herdr",
	"version": "0.2.0",
	"description": "Herdr agents and terminals inside Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"gen:types": "node scripts/gen-types.mjs",
		"install-dev": "node scripts/install-dev.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"herdr",
		"terminal",
		"agents"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@xterm/headless": "5.5.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.7"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nytafar/obsidian-herdr.git"
	},
	"dependencies": {
		"@xterm/addon-fit": "0.10.0",
		"@xterm/addon-unicode11": "0.8.0",
		"@xterm/xterm": "5.5.0",
		"ghostty-web": "0.4.0"
	}
}
